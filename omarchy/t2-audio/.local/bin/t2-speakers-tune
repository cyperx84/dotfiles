<div class="btns"><button class="primary" id="save">Save</button><button id="revert">Revert to saved</button><span id="status"></span></div>
</main>
<script>
const ids=["lp","hp","lpQ","hpQ","protect","woofer","tweeterL","tweeterR","sumL","sumR"];
const inv=["wooferInv","tweeterLInv","tweeterRInv"];
const $=id=>document.getElementById(id);
const fmt={protect:v=>Math.round(v)+" Hz",lp:v=>Math.round(v)+" Hz",hp:v=>Math.round(v)+" Hz",lpQ:v=>(+v).toFixed(3),hpQ:v=>(+v).toFixed(3)};
const show=id=>$(id+"V").textContent=(fmt[id]||(v=>(v>0?"+":"")+(+v).toFixed(1)+" dB"))($(id).value);
function state(){const s={};ids.forEach(i=>s[i]=+$(i).value);inv.forEach(i=>s[i]=$(i).checked);return s}
function load(s){ids.forEach(i=>{$(i).value=s[i];show(i)});inv.forEach(i=>$(i).checked=s[i])}
const status=t=>{$("status").textContent=t};
let t;function push(){clearTimeout(t);t=setTimeout(()=>post("/set",state()),30)}
async function post(path,body){const r=await fetch(path,{method:"POST",body:JSON.stringify(body)});const j=await r.json();if(j.error)status(j.error);return j}
ids.forEach(i=>$(i).addEventListener("input",()=>{
  if($("link").checked&&(i=="lp"||i=="hp")){const o=i=="lp"?"hp":"lp";$(o).value=$(i).value;show(o)}
  show(i);status("unsaved");push()}));
inv.forEach(i=>$(i).addEventListener("change",()=>{status("unsaved");push()}));
document.querySelectorAll("[data-p]").forEach(b=>b.addEventListener("click",()=>{
  document.querySelectorAll("[data-p]").forEach(x=>x.classList.remove("on"));
  if(b.dataset.p!="stop")b.classList.add("on");post("/play",{what:b.dataset.p})}));
$("save").onclick=async()=>{await post("/save",state());status("saved")};
$("revert").onclick=async()=>{load(await post("/revert",{}));status("reverted")};
fetch("/state").then(r=>r.json()).then(s=>{load(s);$("link").checked=s.lp==s.hp});
</script></body></html>"""


def main():
    url = f"http://127.0.0.1:{PORT}/"
    try:
        server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    except OSError:
        webbrowser.open(url)  # already running
        return
    threading.Thread(target=signals, daemon=True).start()
    print(f"T2 speaker tuning at {url}  (Ctrl+C to quit)")
    webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        play("stop")


if __name__ == "__main__":
    sys.exit(main())
