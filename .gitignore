# Compiled binaries
mac/sketchybar/.config/sketchybar/helper/helper

.genkit/
.commandcode/
.DS_Store

# Backup files
*.bak
*.backup
*.backup_*
*.archive
*~

# Runtime logs
.nvimlog
.aider*
__pycache__/

# Local/generated worktrees and plugin installs
.claude/worktrees/
mac/tmux/.tmux/plugins/

# Per-machine ghostty overrides (e.g. cursor-color differs M1 vs M4)
mac/ghostty/.config/ghostty/local.conf

# Per-machine SSH host inventory (hostnames, logins, tailnet IPs). Pulled in by
# the tracked ssh config via `Include ~/.ssh/config.local`. Never commit it —
# this repo is PUBLIC.
mac/ssh/.ssh/config.local
omarchy/ssh/.ssh/config.local

# herdr writes runtime logs + session state into its stowed config dir
# (~/.config/herdr → repo). Only config.toml is ours; never commit the rest
# (session.json can hold live session data — this repo is PUBLIC).
mac/herdr/.config/herdr/*
!mac/herdr/.config/herdr/config.toml
omarchy/herdr/.config/herdr/*
!omarchy/herdr/.config/herdr/config.toml

# OBS: stream key / service lives in profiles/*/service.json — never commit.
# mac/obs/install.sh --pull already skips it; this is the backstop.
mac/obs/**/service.json
