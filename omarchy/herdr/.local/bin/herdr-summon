#!/usr/bin/env bash
# alt+e anywhere (omarchy/hypr/.config/hypr/bindings.lua): focus, or launch, the
# Ghostty window running herdr, bring it back to Local if it is showing another
# machine, then toggle the sesh-bro picker. The Omarchy counterpart of
# summonHerdr in mac/hammerspoon/.hammerspoon/init.lua.
#
# The window is found by its title, which herdr sets from window_title in
# [ui]: every machine's config starts it with "herdr" for this. Hyprland's
# global ALT + E swallows the key inside herdr too, so this script, not herdr's
# own alt+e binding, is what opens the picker here.
set -uo pipefail

CLASS=com.mitchellh.ghostty
SELECTION="${XDG_STATE_HOME:-$HOME/.local/state}/herdr/client/endpoint-selection.json"
PLUGINS="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins.json"

herdr_window() {
  hyprctl clients -j |
    jq -r --arg c "$CLASS" '[.[] | select(.class == $c and (.title | startswith("herdr")))][0].address // empty'
}

showing_local() {
  [[ ! -f $SELECTION ]] || [[ -z $(jq -r '.selected_profile // empty' "$SELECTION") ]]
}

sesh_bro() {
  jq -r '.[] | select(.plugin_id == "sesh-bro") | .plugin_root + "/bin/sesh-bro"' "$PLUGINS" 2>/dev/null | head -1
}

# The popup is an overlay with no pane id, so "already open" is the only way to
# know it is up, and escape (fzf's exit key) is the way to close it.
toggle_picker() {
  local addr=$1 out
  out=$(herdr plugin pane open --plugin sesh-bro --entrypoint picker 2>&1)
  if [[ $out == *"already open"* ]]; then
    hyprctl dispatch "hl.dsp.send_shortcut({ mods = \"\", key = \"ESCAPE\", window = \"address:$addr\" })" >/dev/null
  fi
}

addr=$(herdr_window)
if [[ -z $addr ]]; then
  setsid uwsm-app -- ghostty -e herdr >/dev/null 2>&1 &
  for _ in $(seq 30); do
    sleep 0.2
    addr=$(herdr_window)
    [[ -n $addr ]] && break
  done
  [[ -z $addr ]] && exit 1
  sleep 0.6 # let the TUI paint before the popup opens over it
fi

hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null

# A popup belongs to the server whose surface is drawn, so on another machine
# the picker would open where nobody can see it. sesh-bro steps the window back
# by pressing next_workspace until the selection file says Local.
if ! showing_local; then
  bin=$(sesh_bro)
  [[ -x $bin ]] || exit 1
  "$bin" focus --machine local || exit 1
fi
toggle_picker "$addr"
