# SSH client config — managed in dotfiles (mac/ssh/.ssh/config), stowed to ~/.ssh/config.
#
# The machine inventory is deliberately NOT tracked: this repo is PUBLIC, and
# host names, logins and tailnet IPs are per-machine recon data rather than
# config worth sharing. Host blocks live in ~/.ssh/config.local (create per
# machine, chmod 600), shaped like:
#
#     # <role, e.g. mini running the builds>
#     Host <alias>
#         HostName <magicdns-name-or-ip>
#         User <user>
#
# Add a machine = add a Host block there (and a matching sesh ssh entry).

# Colima (Docker) generated config. ~ keeps it portable across users/machines;
# OpenSSH silently skips it where the file doesn't exist (e.g. machines w/o colima).
Include ~/.colima/ssh_config

# Per-machine host blocks (untracked — see header). Literal path, never a glob:
# a glob would also sweep up anything else named config.* in this directory.
# MUST stay ABOVE `Host *`: ssh takes the FIRST value obtained for each keyword,
# so a `Host *` matched before these would shadow their per-host settings — the
# router block in there turns StrictHostKeyChecking off and has to win.
# Silently skipped where the file doesn't exist.
Include ~/.ssh/config.local

# Defaults for all hosts. accept-new auto-trusts a first-seen host key (so the
# first connection between machines doesn't prompt) but still REJECTS a key that
# later changes — keeps MITM protection. Fine for your own tailnet machines.
Host *
    StrictHostKeyChecking accept-new
