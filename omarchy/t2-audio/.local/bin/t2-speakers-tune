#!/usr/bin/env python3
"""Live control panel for the "Speakers" filter-chain (90-t2-speakers.conf).

Serves a page on 127.0.0.1 with the crossover, per-driver level and polarity,
the bass sum, and test signals. Moving a control changes the running sink;
Save writes the values back into the config (follows the stow symlink into
the dotfiles), Revert reloads them from it.
"""
import json
import math
import os
import re
import subprocess
import sys
import threading
import wave
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 8752
SINK = "t2_speakers"
HW_SINK = "alsa_output.pci-0000_04_00.3.HiFi__Speaker__sink"
CONF = os.path.realpath(os.path.expanduser(
    "~/.config/pipewire/pipewire.conf.d/90-t2-speakers.conf"))
CACHE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "t2-speakers-tune")
RATE = 48000

# UI control -> filter-chain params it drives
HP = ["tweeterL1", "tweeterL2", "tweeterR1", "tweeterR2"]
LP = ["bassLP1", "bassLP2"]
WOOF_HP = ["woofHP1", "woofHP2"]
GAINS = {"woofer": "wooferGain", "tweeterL": "tweeterLGain", "tweeterR": "tweeterRGain"}


def node_id(name):
    out = subprocess.run(["pw-dump"], capture_output=True, text=True).stdout
    for o in json.loads(out or "[]"):
        if ((o.get("info") or {}).get("props") or {}).get("node.name") == name:
            return o["id"]
    raise RuntimeError(f"{name} not found; is PipeWire running?")


def read_params():
    out = subprocess.run(["pw-cli", "e", str(node_id(SINK)), "Props"],
                         capture_output=True, text=True).stdout
    vals, key = {}, None
    for line in out.splitlines():
        m = re.match(r'\s*String "(.+)"', line)
        if m:
            key = m.group(1)
            continue
        m = re.match(r"\s*Float (\S+)", line)
        if m and key:
            vals[key] = float(m.group(1))
        key = None
    return vals


def write_params(params):
    # The graph takes Props on the playback side; the sink side ignores them
    flat = " ".join(f'"{k}" {v:.6f}' for k, v in params.items())
    subprocess.run(["pw-cli", "s", str(node_id(SINK + ".output")), "Props",
                    f"{{ params = [ {flat} ] }}"], capture_output=True)


def db(g):
    return 20 * math.log10(abs(g)) if g else -60.0


def ui_state(p):
    s = {
        "hp": p["tweeterL1:Freq"], "hpQ": p["tweeterL1:Q"],
        "lp": p["bassLP1:Freq"], "lpQ": p["bassLP1:Q"],
        "protect": p["woofHP1:Freq"],
        "sumL": db(p["bassMix:Gain 1"]), "sumR": db(p["bassMix:Gain 2"]),
    }
    for ui, node in GAINS.items():
        g = p[f"{node}:Gain 1"]
        s[ui] = round(db(g), 2)
        s[ui + "Inv"] = g < 0
    return s


def to_params(s):
    p = {}
    for n in HP:
        p[f"{n}:Freq"], p[f"{n}:Q"] = s["hp"], s["hpQ"]
    for n in LP:
        p[f"{n}:Freq"], p[f"{n}:Q"] = s["lp"], s["lpQ"]
    for n in WOOF_HP:
        p[f"{n}:Freq"] = s["protect"]
    p["bassMix:Gain 1"] = 10 ** (s["sumL"] / 20)
    p["bassMix:Gain 2"] = 10 ** (s["sumR"] / 20)
    for ui, node in GAINS.items():
        p[f"{node}:Gain 1"] = (-1 if s[ui + "Inv"] else 1) * 10 ** (s[ui] / 20)
    return p


def conf_params():
    text = open(CONF).read()
    p = {}
    for node, body in re.findall(r"name = (\w+)\s+control = \{([^}]*)\}", text):
        for k, v in re.findall(r'"([^"]+)" = (-?[\d.]+)', body):
            p[f"{node}:{k}"] = float(v)
    return p


def save_conf(params):
    text = open(CONF).read()

    def fix(m):
        node = m.group(1)

        def value(kv):
            v = params.get(f"{node}:{kv.group(1)}", float(kv.group(2)))
            return f'"{kv.group(1)}" = {round(v, 4)}'
        return re.sub(r'"([^"]+)" = (-?[\d.]+)', value, m.group(0))

    text = re.sub(r"name = (\w+)\s+control = \{[^}]*\}", fix, text)
    with open(CONF, "w") as f:
        f.write(text)


# --- test signals ----------------------------------------------------------

def write_wav(path, frames, channels):
    import numpy as np
    pcm = (np.clip(frames, -1, 1) * 32767).astype("<i2")
    with wave.open(path, "wb") as w:
        w.setnchannels(channels)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(pcm.tobytes())


def signals():
    import numpy as np
    os.makedirs(CACHE, exist_ok=True)
    if os.path.exists(os.path.join(CACHE, "sweep.wav")):
        return
    rng = np.random.default_rng(1)
    n = RATE * 30

    def pink():
        spec = np.fft.rfft(rng.standard_normal(n))
        f = np.fft.rfftfreq(n, 1 / RATE)
        spec[1:] /= np.sqrt(f[1:])
        spec[0] = 0
        x = np.fft.irfft(spec, n)
        return x / np.sqrt(np.mean(x ** 2)) * 10 ** (-20 / 20)  # -20 dBFS RMS

    a, b, z = pink(), pink(), np.zeros(n)
    write_wav(os.path.join(CACHE, "L.wav"), np.stack([a, z], 1), 2)
    write_wav(os.path.join(CACHE, "R.wav"), np.stack([z, a], 1), 2)
    write_wav(os.path.join(CACHE, "mono.wav"), np.stack([a, a], 1), 2)
    write_wav(os.path.join(CACHE, "stereo.wav"), np.stack([a, b], 1), 2)
    for ch in range(4):
        x = np.zeros((n, 4))
        x[:, ch] = a
        write_wav(os.path.join(CACHE, f"ch{ch}.wav"), x, 4)
    # 50 Hz - 10 kHz log sweep, 20 s, mono, -12 dBFS
    t = np.arange(RATE * 20) / RATE
    k = math.log(10000 / 50)
    s = 10 ** (-12 / 20) * np.sin(2 * math.pi * 50 * 20 / k * (np.exp(t / 20 * k) - 1))
    write_wav(os.path.join(CACHE, "sweep.wav"), np.stack([s, s], 1), 2)


player = None
lock = threading.Lock()


def play(what):
    global player
    with lock:
        if player and player.poll() is None:
            player.terminate()
        player = None
        if what == "stop":
            return
        signals()
        path = os.path.join(CACHE, what + ".wav")
        if what.startswith("ch"):
            cmd = ["pw-play", "--target", HW_SINK, "--channel-map", "FL,FR,RL,RR", path]
        else:
            cmd = ["pw-play", "--target", SINK, path]
        player = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# --- web -------------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def reply(self, body, ctype="application/json", code=200):
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/":
            return self.reply(PAGE, "text/html; charset=utf-8")
        if self.path == "/state":
            return self.reply(json.dumps(ui_state(read_params())))
        self.reply("{}", code=404)

    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or "{}")
        try:
            if self.path == "/set":
                write_params(to_params(body))
            elif self.path == "/play":
                play(body["what"])
            elif self.path == "/save":
                save_conf(to_params(body))
            elif self.path == "/revert":
                write_params(conf_params())
                return self.reply(json.dumps(ui_state({**read_params(), **conf_params()})))
            self.reply("{}")
        except Exception as e:
            self.reply(json.dumps({"error": str(e)}), code=500)


PAGE = r"""<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>T2 Speakers</title>
<style>
:root{--bg:#f6f6f4;--card:#fff;--fg:#1c1c1c;--mute:#6b6b6b;--line:#e2e2de;--acc:#2f7d4f;--warn:#b5432f}
@media (prefers-color-scheme:dark){:root{--bg:#141414;--card:#1d1d1d;--fg:#e9e9e6;--mute:#9a9a95;--line:#2d2d2b;--acc:#5fbf86;--warn:#e07a63}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.45 system-ui,sans-serif}
