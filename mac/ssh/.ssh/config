# SSH client config — managed in dotfiles (mac/ssh/.ssh/config), stowed to ~/.ssh/config.
# Host entries use Tailscale MagicDNS names; tailnet IPs kept as fallback comments.
# Add a machine = add a Host block (and a matching sesh ssh entry).

# Colima (Docker) generated config. ~ keeps it portable across users/machines;
# OpenSSH silently skips it where the file doesn't exist (e.g. machines w/o colima).
Include ~/.colima/ssh_config

# m4 Mac mini — provisioning machine
Host m4
    HostName m4-mini
    User cyperx
    # tailnet IP fallback: 100.74.220.17

# m1 Mac mini — desktop twin
Host m1
    HostName m1-mini
    User m1
    # tailnet IP fallback: 100.94.144.9   | LAN fallback: m1.local

# omarchy — Linux on the tailnet
Host omarchy
    HostName omarchy
    User cyperx
    # tailnet IP fallback: 100.72.165.70

# Consumer router — only speaks pre-modern crypto, so re-enable the legacy
# algorithms for this host alone. It regenerates its host key, hence no strict
# checking and a throwaway known-hosts file. MUST stay ABOVE `Host *`: ssh uses
# the FIRST value obtained for each keyword, so a `Host *` match earlier in the
# file would shadow StrictHostKeyChecking here.
# ssh-dss is deliberately absent — OpenSSH 10.x removed it, and naming it makes
# ssh reject the whole config file for EVERY host.
Host router 192.168.1.1
    HostName 192.168.1.1
    User admin
    KexAlgorithms +diffie-hellman-group14-sha1
    HostKeyAlgorithms +ssh-rsa
    PubkeyAcceptedAlgorithms +ssh-rsa
    Ciphers +aes128-cbc,3des-cbc
    MACs +hmac-sha1
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    RequestTTY yes

# Defaults for all hosts. accept-new auto-trusts a first-seen host key (so the
# first connection between machines doesn't prompt) but still REJECTS a key that
# later changes — keeps MITM protection. Fine for your own tailnet machines.
Host *
    StrictHostKeyChecking accept-new
